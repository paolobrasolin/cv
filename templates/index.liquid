<!DOCTYPE html>
<html lang="en">

<head>
  <title>Paolo Brasolin | CV</title>

  <meta charset="utf-8">
  <meta name="theme-color" content="#000000">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Paolo Brasolin Curriculum Vitae">

  <link rel="shortcut icon" href="data:image/x-icon;base64,{{ assets.favicon_base64 }}" />

</head>

<body>
  <style>{{ assets.css }}</style>
  {{ assets.icons_svg }}
  <main>
    <header>
      <h1>Paolo Brasolin</h1>

      <ul id="contacts">
        {% for item in data.contacts %}
        <li>
          <svg class="icon" aria-hidden="true" focusable="false" title="{{ item.label }}">
            <use href="#{{ item.icon }}">
          </svg>
          <span class="sr-only">{{ item.label }}:</span>
          <a target="_blank" href="{{ item.link }}">{{ item.value }}</a>
        </li>
        {% endfor %}
        <li class="print-hidden">
          <svg class="icon" aria-hidden="true" focusable="false" title="PDF">
            <use href="#file-pdf">
          </svg>
          <span class="sr-only">PDF:</span>
          <a download href="https://github.com/paolobrasolin/cv/raw/main/assets/paolo-brasolin-cv.pdf">
            Download PDF version
          </a>
        </li>
        <li class="screen-hidden">
          <svg class="icon" aria-hidden="true" focusable="false" title="Web">
            <use href="#globe">
          </svg>
          <span class="sr-only">Web:</span>
          <a href="https://paolobrasolin.github.io/cv/">
            Visit web version
          </a>
        </li>
      </ul>

      <nav>
        <ul>
          <li><a href="#profile">Profile</a></li>
          <li><a href="#experience">Experience</a></li>
          <li><a href="#education">Education</a></li>
          <li><a href="#service">Service</a></li>
          <li><a href="#publications">Publications</a></li>
        </ul>
      </nav>
    </header>

    {% render 'simple_section', content: data.profile %}
    {% render 'events_section', content: data.experience %}
    {% render 'events_section', content: data.education %}
    {% render 'simple_section', content: data.service %}
    {% render 'simple_section', content: data.publications %}
  </main>
</body>

</html>
