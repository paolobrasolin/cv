{% if content.items %}
<section>
  <h2 id="{{ content.title | slugify }}">{{ content.title }}</h2>

  {% for item in content.items %}
  <article>

    <header>
      <h3>{{ item.title | markdownify | remove: "<p>" | remove: "</p>" }}</h3>
      <div>{{ item.employer }}{% if item.location %}, {{ item.location }}{% endif %}</div>
      <time datetime="{{ item.dates.range }}">{{ item.dates.label | markdownify | remove: "<p>" | remove: "</p>" }}</time>
    </header>

    {% if item.extra %}
    {{ item.extra | markdownify }}
    {% endif %}

  </article>
  {% endfor %}

</section>
{% endif %}
